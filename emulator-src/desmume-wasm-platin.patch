--- a/desmume/src/ROMReader.cpp
+++ b/desmume/src/ROMReader.cpp
@@ -122,6 +122,7 @@ int STDROMReaderRead(void * file, void * buffer, u32 size)
 	if (pos + read > romLen)  {
 		read = romLen - pos;
 	}
+	if (read <= 0) return 0; // Platin Touch: hinter dem Ende (gekürzte ROM) – Leser füllt mit 0xFF auf
 	memcpy(buffer,romBuffer + pos, read);
 	((STDROMReaderData*)file)->pos += read;
 	return read;
