diff --git a/src/touch_bridge.c b/src/touch_bridge.c
new file mode 100644
index 00000000..f3af3a0e
--- /dev/null
+++ b/src/touch_bridge.c
@@ -0,0 +1,311 @@
+#include "touch_bridge.h"
+
+#include <nitro.h>
+#include <nnsys.h>
+
+#include "constants/map_object.h"
+
+#include "field/field_system.h"
+
+#include "map_object.h"
+#include "player_avatar.h"
+#include "system.h"
+
+// Platin Touch – Spielseite der Brücke zur Handy-App (siehe include/touch_bridge.h).
+
+TouchBridge gTouchBridge;
+
+static u8 sLastSeq;
+static u8 sPending;
+static u8 sPendingAge;
+static u8 sPendingScreen;
+static u8 sPendingX;
+static u8 sPendingY;
+static u8 sPendingSeq;
+
+void TouchBridge_Init(void)
+{
+    MI_CpuClear8(&gTouchBridge, sizeof(TouchBridge));
+    gTouchBridge.version = TOUCH_BRIDGE_VERSION;
+    gTouchBridge.size = sizeof(TouchBridge);
+    gTouchBridge.systemAddr = (u32)&gSystem;
+    sLastSeq = 0;
+    sPending = FALSE;
+    // Kennung zuletzt schreiben: erst dann ist die Struktur für die App gültig
+    gTouchBridge.magic1 = TOUCH_BRIDGE_MAGIC1;
+    gTouchBridge.magic0 = TOUCH_BRIDGE_MAGIC0;
+}
+
+static void FinishTap(u8 result)
+{
+    gTouchBridge.tapResult = result;
+    gTouchBridge.tapAck = sPendingSeq;
+    sPending = FALSE;
+}
+
+void TouchBridge_Frame(void)
+{
+    TouchBridge *tb = &gTouchBridge;
+
+    tb->frame++;
+    tb->dispSelect = (u8)GX_GetDispSelect();
+    tb->screen3D = gSystem.whichScreenIs3D;
+
+    if (sPending) {
+        // Ein Bild lang hat kein Menü das Antippen abgeholt.
+        u32 sinceMenu = tb->frame - tb->menuFrame;
+
+        BOOL inBattle = tb->frame - tb->battleFrame <= 3;
+        BOOL textWaiting = tb->frame - tb->textWaitFrame <= 3;
+
+        // Im Kampf löst Tippen oben nur "weiter" aus, wenn ein Text wartet: sonst würde
+        // es im Kampfmenü versehentlich KAMPF/Attacke wählen (das Menü ist unten).
+        if (sPendingScreen == 0 && (tb->appFlags & TB_APP_TAP_IS_A) && sinceMenu > 3 && (s32)(tb->frame - tb->noTapAUntil) > 0 && (!inBattle || textWaiting)) {
+            // Kein Menü offen: Antippen des oberen Bildschirms = A (Text weiter, ansprechen, bestätigen)
+            gSystem.pressedKeys |= PAD_BUTTON_A;
+            gSystem.heldKeys |= PAD_BUTTON_A;
+            gSystem.pressedKeysRepeatable |= PAD_BUTTON_A;
+            tb->tapsAsA++;
+            FinishTap(TB_TAP_BUTTON);
+        } else {
+            FinishTap(TB_TAP_DROPPED);
+        }
+    }
+
+    if (tb->tapSeq != sLastSeq) {
+        sLastSeq = tb->tapSeq;
+        sPending = TRUE;
+        sPendingAge = 0;
+        sPendingSeq = tb->tapSeq;
+        sPendingScreen = tb->tapScreen ? 1 : 0;
+        sPendingX = tb->tapX;
+        sPendingY = tb->tapY;
+    }
+}
+
+BOOL TouchBridge_TakeTap(int screen, int *outX, int *outY)
+{
+    if (!sPending || sPendingScreen != screen) {
+        return FALSE;
+    }
+
+    *outX = sPendingX;
+    *outY = sPendingY;
+    return TRUE;
+}
+
+void TouchBridge_TapResult(u8 result)
+{
+    if (!sPending) {
+        return;
+    }
+
+    if (result == TB_TAP_HIT || result == TB_TAP_SCROLL) {
+        gTouchBridge.tapsHit++;
+    }
+
+    FinishTap(result);
+}
+
+int TouchBridge_LayerScreen(u8 bgLayer)
+{
+    BOOL isMain = bgLayer < 4;
+    BOOL mainOnTop = GX_GetDispSelect() == GX_DISP_SELECT_MAIN_SUB;
+
+    return (isMain == mainOnTop) ? 0 : 1;
+}
+
+void TouchBridge_NoteMenu(u8 kind, u8 screen, int x, int y, int w, int h, int rows, int cols, int cursor, int rowH, int itemX0, int itemY0, int colW, int listPos, int listCount)
+{
+    TouchBridge *tb = &gTouchBridge;
+
+    if (tb->menuFrame != tb->frame) {
+        tb->menusSeen++;
+    }
+
+    tb->menuKind = kind;
+    tb->menuScreen = screen;
+    tb->menuFrame = tb->frame;
+    tb->menuX = (s16)x;
+    tb->menuY = (s16)y;
+    tb->menuW = (u16)w;
+    tb->menuH = (u16)h;
+    tb->menuRows = (u8)rows;
+    tb->menuCols = (u8)cols;
+    tb->menuCursor = (u8)cursor;
+    tb->menuRowH = (u8)rowH;
+    tb->itemX0 = (s16)itemX0;
+    tb->itemY0 = (s16)itemY0;
+    tb->colW = (u16)colW;
+    tb->listPos = (u16)listPos;
+    tb->listCount = (u16)listCount;
+}
+
+void TouchBridge_SuppressTapA(void)
+{
+    gTouchBridge.noTapAUntil = gTouchBridge.frame + 2;
+}
+
+void TouchBridge_NoteText(BOOL waiting)
+{
+    gTouchBridge.textFrame = gTouchBridge.frame;
+
+    if (waiting) {
+        gTouchBridge.textWaitFrame = gTouchBridge.frame;
+    }
+}
+
+void TouchBridge_FieldFrame(FieldSystem *fieldSystem)
+{
+    TouchBridge *tb = &gTouchBridge;
+
+    if (fieldSystem == NULL || fieldSystem->playerAvatar == NULL || fieldSystem->mapObjMan == NULL) {
+        return;
+    }
+
+    tb->fieldFrame = tb->frame;
+    tb->playerX = (s16)PlayerAvatar_GetXPos(fieldSystem->playerAvatar);
+    tb->playerZ = (s16)PlayerAvatar_GetZPos(fieldSystem->playerAvatar);
+    tb->playerDir = (u8)PlayerAvatar_GetFacingDir(fieldSystem->playerAvatar);
+
+    // Figuren nur, wenn die 3D-Welt oben zu sehen ist
+    int count = 0;
+
+    if (GX_GetDispSelect() == GX_DISP_SELECT_MAIN_SUB) {
+        MapObject *player = PlayerAvatar_GetMapObject(fieldSystem->playerAvatar);
+        MapObject *mapObj = NULL;
+        int idx = 0;
+
+        while (count < TB_MAX_NPCS && MapObjectMan_FindObjectWithStatus(fieldSystem->mapObjMan, &mapObj, &idx, MAP_OBJ_STATUS_0)) {
+            if (mapObj == player || MapObject_IsHidden(mapObj)) {
+                continue;
+            }
+
+            VecFx32 pos;
+            int sx, sy;
+
+            MapObject_GetPosPtr(mapObj, &pos);
+
+            if (NNS_G3dWorldPosToScrPos(&pos, &sx, &sy) != 0) {
+                continue; // nicht im Bild
+            }
+
+            tb->npcs[count].screenX = (s16)sx;
+            tb->npcs[count].screenY = (s16)sy;
+            tb->npcs[count].tileX = (s16)MapObject_GetX(mapObj);
+            tb->npcs[count].tileZ = (s16)MapObject_GetZ(mapObj);
+            count++;
+        }
+    }
+
+    tb->npcCount = (u8)count;
+}
+
+void TouchBridge_NoteBattle(void)
+{
+    gTouchBridge.battleFrame = gTouchBridge.frame;
+}
+
+// ---- Menüs unten in der App ----
+
+// Index im Tilemap-Puffer einer Text-Ebene (wie in bg_window.c)
+static int TilemapIndex(int x, int y)
+{
+    return ((y & 0x20) * 32) + ((x & 0x20) * 32) + ((y & 0x1F) * 32) + (x & 0x1F);
+}
+
+void TouchBridge_NoteBottomFree(void)
+{
+    gTouchBridge.bottomFreeFrame = gTouchBridge.frame;
+}
+
+BOOL TouchBridge_OwnMenuWindow(Window *window, int labelX, int bgIndex, int style, BOOL isList)
+{
+    TouchBridge *tb = &gTouchBridge;
+
+    if (isList && tb->frame - tb->bottomFreeFrame > 2) {
+        return FALSE;
+    }
+
+    if (!(tb->appFlags & TB_APP_MENUS_BOTTOM) || window == NULL || window->bgConfig == NULL || window->pixels == NULL) {
+        return FALSE;
+    }
+
+    if (window->bgLayer >= BG_LAYER_MAX || TouchBridge_LayerScreen(window->bgLayer) != 0) {
+        return FALSE;
+    }
+
+    if (window->colorMode != BG_COLOR_MODE_4BPP || window->width == 0 || window->height == 0 || window->width > 32 || window->height > 24) {
+        return FALSE;
+    }
+
+    BgConfig *bgConfig = window->bgConfig;
+    Background *bg = &bgConfig->bgs[window->bgLayer];
+
+    if (bg->type == BG_TYPE_AFFINE || bg->tilemapBuffer == NULL) {
+        return FALSE;
+    }
+
+    // Fenster samt Rahmen (eine Kachel ringsum) oben ausblenden. Nur wenn dort noch etwas steht,
+    // sonst würde jedes Bild unnötig neu übertragen.
+    int x0 = window->tilemapLeft - 1;
+    int y0 = window->tilemapTop - 1;
+    int x1 = window->tilemapLeft + window->width + 1;
+    int y1 = window->tilemapTop + window->height + 1;
+
+    if (x0 < 0) {
+        x0 = 0;
+    }
+    if (y0 < 0) {
+        y0 = 0;
+    }
+    if (x1 > 32) {
+        x1 = 32;
+    }
+    if (y1 > 32) {
+        y1 = 32;
+    }
+
+    u16 *tilemap = bg->tilemapBuffer;
+    u32 entries = bg->bufferSize / 2;
+    BOOL dirty = FALSE;
+
+    for (int y = y0; y < y1 && !dirty; y++) {
+        for (int x = x0; x < x1; x++) {
+            u32 idx = TilemapIndex(x, y);
+
+            if (idx < entries && tilemap[idx] != 0) {
+                dirty = TRUE;
+                break;
+            }
+        }
+    }
+
+    if (dirty) {
+        Bg_FillTilemapRect(bgConfig, window->bgLayer, 0, x0, y0, x1 - x0, y1 - y0, 0);
+        Bg_CopyTilemapBufferToVRAM(bgConfig, window->bgLayer);
+    }
+
+    // Beschreibung für die App
+    const u16 *pltt = (const u16 *)((window->bgLayer < 4 ? HW_BG_PLTT : HW_DB_BG_PLTT) + window->palette * 32);
+
+    for (int i = 0; i < 16; i++) {
+        tb->pal[i] = pltt[i];
+    }
+
+    tb->pixAddr = (u32)window->pixels;
+    tb->tilesW = window->width;
+    tb->tilesH = window->height;
+    tb->colorMode = 0;
+    tb->menuStyle = (u8)style;
+    tb->labelX = (u8)(labelX < 0 ? 0 : labelX);
+    tb->bgIndex = (u8)bgIndex;
+    tb->ownFrame = tb->frame;
+
+    return TRUE;
+}
+
+BOOL TouchBridge_MenuOwned(void)
+{
+    return gTouchBridge.ownFrame == gTouchBridge.frame && gTouchBridge.frame != 0;
+}
