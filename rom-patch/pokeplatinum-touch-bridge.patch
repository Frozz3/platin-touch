+}
+
+static u32 ProcessInputInner(ListMenu *menu)
 {
     menu->lastAction = LIST_MENU_ACTION_NONE;
 
+    int touched = TryTouchSelect(menu);
+    if (touched == 1) {
+        return menu->template.choices[menu->listPos + menu->cursorPos].index;
+    } else if (touched == 2) {
+        return MENU_NOTHING_CHOSEN;
+    }
+
     if (JOY_NEW(PAD_BUTTON_A)) {
         return menu->template.choices[menu->listPos + menu->cursorPos].index;
     }
@@ -561,3 +580,83 @@ static void InvokeCursorCallback(ListMenu *menu, u8 onInit)
         menu->template.cursorCallback(menu, menu->template.choices[menu->listPos + menu->cursorPos].index, onInit);
     }
 }
+
+// Platin Touch: Antippen einer Listenzeile (über die TouchBridge) wählt sie direkt aus,
+// Antippen knapp über/unter der Liste (Pfeile) blättert eine Seite weiter.
+// Rückgabe: 1 = Eintrag gewählt, 2 = geblättert, 0 = nichts.
+static int TryTouchSelect(ListMenu *menu)
+{
+    Window *window = menu->template.window;
+
+    if (window == NULL || menu->template.maxDisplay == 0) {
+        return 0;
+    }
+
+    int screen = TouchBridge_LayerScreen(window->bgLayer);
+    int originX = window->tilemapLeft * 8 - Bg_GetXOffset(window->bgConfig, window->bgLayer);
+    int originY = window->tilemapTop * 8 - Bg_GetYOffset(window->bgConfig, window->bgLayer);
+    int rowH = Font_GetAttribute(menu->template.fontID, FONTATTR_MAX_LETTER_HEIGHT) + menu->template.lineSpacing;
+    int width = window->width * 8;
+    int height = window->height * 8;
+    int firstY = originY + menu->template.yOffset;
+
+    if (rowH <= 0) {
+        rowH = 16;
+    }
+
+    TouchBridge_NoteMenu(TB_MENU_LIST, screen, originX, originY, width, height, menu->template.maxDisplay, 1, menu->cursorPos, rowH, originX, firstY, width, menu->listPos, menu->template.count);
+
+    int tapX, tapY;
+    if (!TouchBridge_TakeTap(screen, &tapX, &tapY)) {
+        return 0;
+    }
+
+    if (tapX < originX - 6 || tapX >= originX + width + 6) {
+        TouchBridge_TapResult(TB_TAP_MISS);
+        return 0;
+    }
+
+    if (tapY < firstY) {
+        if (tapY >= originY - 16 && menu->listPos > 0) {
+            UpdateSelectedRow(menu, TRUE, menu->template.maxDisplay, FALSE);
+            menu->lastAction = LIST_MENU_ACTION_PAGE_UP;
+            TouchBridge_TapResult(TB_TAP_SCROLL);
+            return 2;
+        }
+
+        TouchBridge_TapResult(TB_TAP_MISS);
+        return 0;
+    }
+
+    int row = (tapY - firstY) / rowH;
+
+    if (row >= menu->template.maxDisplay) {
+        if (tapY < originY + height + 16 && menu->listPos + menu->template.maxDisplay < menu->template.count) {
+            UpdateSelectedRow(menu, TRUE, menu->template.maxDisplay, TRUE);
+            menu->lastAction = LIST_MENU_ACTION_PAGE_DOWN;
+            TouchBridge_TapResult(TB_TAP_SCROLL);
+            return 2;
+        }
+
+        TouchBridge_TapResult(TB_TAP_MISS);
+        return 0;
+    }
+
+    if (menu->listPos + row >= menu->template.count || menu->template.choices[menu->listPos + row].index == MENU_HEADER) {
+        TouchBridge_TapResult(TB_TAP_MISS);
+        return 0;
+    }
+
+    if (row != menu->cursorPos) {
+        u16 oldPos = menu->cursorPos;
+
+        EraseCursor(menu, oldPos);
+        menu->cursorPos = row;
+        PrintCursor(menu);
+        InvokeCursorCallback(menu, FALSE);
+        Window_CopyToVRAM(menu->template.window);
+    }
+
+    TouchBridge_TapResult(TB_TAP_HIT);
+    return 1;
+}
