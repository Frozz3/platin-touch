+// Platin Touch: Junge (rechts) oder Mädchen (links) oben antippen wählt die Figur aus und bestätigt sie
+// (danach fragt das Spiel wie gewohnt mit Ja/Nein nach).
+static void RowanIntro_TouchSelectGender(RowanIntro *manager)
+{
+    int tapX, tapY;
+
+    TouchBridge_NoteMenu(TB_MENU_MENU, 0, 0, 0, 256, 144, 1, 2, manager->playerGender == GENDER_MALE ? 1 : 0, 144, 0, 0, 128, 0, 2);
+
+    if (!TouchBridge_TakeTap(0, &tapX, &tapY)) {
+        return;
+    }
+
+    if (tapY >= 144) {
+        TouchBridge_TapResult(TB_TAP_MISS); // Textfeld
+        return;
+    }
+
+    enum Gender gender = tapX < 128 ? GENDER_FEMALE : GENDER_MALE;
+
+    if (gender != manager->playerGender) {
+        manager->playerGender = gender;
+        Sound_PlayEffect(SE_CONFIRM_sseq_3);
+    }
+
+    gSystem.pressedKeys |= PAD_BUTTON_A;
+    TouchBridge_TapResult(TB_TAP_HIT);
+}
