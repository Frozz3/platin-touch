+#ifndef POKEPLATINUM_TOUCH_BRIDGE_H
+#define POKEPLATINUM_TOUCH_BRIDGE_H
+
+// Platin Touch: kleine Brücke zwischen dem Spiel und der Handy-App.
+//
+// Die App (Emulator im Browser) findet diese Struktur über die Kennung im Arbeitsspeicher.
+// Sie schreibt Antipp-Ereignisse hinein (Koordinaten auf dem oberen oder unteren Bildschirm),
+// das Spiel wertet sie in seinen Menüs aus (Eintrag direkt auswählen) und meldet zurück,
+// was es gerade zeigt. Ohne App ändert sich am Spiel nichts: solange die App nichts schreibt,
+// bleibt alles wie im Original.
+
+#include <nitro.h>
+
+#include "field/field_system_decl.h"
+
+#include "bg_window.h"
+
+#define TOUCH_BRIDGE_MAGIC0  0x31425450 // "PTB1"
+#define TOUCH_BRIDGE_MAGIC1  0x48435554 // "TUCH"
+#define TOUCH_BRIDGE_VERSION 4
+
+// tapResult
+#define TB_TAP_NONE    0
+#define TB_TAP_HIT     1 // Menüeintrag getroffen und ausgewählt
+#define TB_TAP_MISS    2 // Menü aktiv, aber daneben getippt (ignoriert)
+#define TB_TAP_BUTTON  3 // kein Menü: als A-Taste ausgeführt
+#define TB_TAP_DROPPED 4 // verworfen (z. B. Menü gerade erst geschlossen)
+#define TB_TAP_SCROLL  5 // Pfeil einer Liste getroffen: eine Seite weiter
+
+// appFlags (App -> Spiel)
+#define TB_APP_TAP_IS_A 0x01 // Tippen ohne Menü löst A aus (nur oberer Bildschirm)
+#define TB_APP_MENUS_BOTTOM 0x02 // Auswahlmenüs vom oberen Bildschirm zeigt die App unten an
+
+// menuKind
+#define TB_MENU_NONE 0
+#define TB_MENU_MENU 1
+#define TB_MENU_LIST 2
+
+#define TB_MAX_NPCS 20
+
+// Figur auf der Karte: Fußpunkt auf dem Bildschirm (Pixel oben) und Kachel
+typedef struct TouchBridgeNpc {
+    s16 screenX;
+    s16 screenY;
+    s16 tileX;
+    s16 tileZ;
+} TouchBridgeNpc;
+
+typedef struct TouchBridge {
+    u32 magic0; // 0
+    u32 magic1; // 4
+    u16 version; // 8
+    u16 size; // 10
+    u32 frame; // 12  Bildzähler der Brücke
+    // ---- App -> Spiel ----
+    u8 tapSeq; // 16  laufende Nummer, die App erhöht sie bei jedem Tippen
+    u8 tapX; // 17
+    u8 tapY; // 18
+    u8 tapScreen; // 19  0 = oben, 1 = unten
+    u8 appFlags; // 20
+    u8 appHeartbeat; // 21
+    u8 appReserved0; // 22
+    u8 appReserved1; // 23
+    // ---- Spiel -> App ----
+    u8 tapAck; // 24  zuletzt bearbeitete Nummer
+    u8 tapResult; // 25
+    u8 menuKind; // 26  zuletzt aktives Menü (das Eingaben abgefragt hat)
+    u8 menuScreen; // 27  0 = oben, 1 = unten
+    u32 menuFrame; // 28  Bild, in dem es zuletzt Eingaben abgefragt hat
+    s16 menuX; // 32  Fenster in Bildschirm-Pixeln
+    s16 menuY; // 34
+    u16 menuW; // 36
+    u16 menuH; // 38
+    u8 menuRows; // 40  sichtbare Zeilen
+    u8 menuCols; // 41
+    u8 menuCursor; // 42  Zeile des Cursors (Liste: sichtbare Zeile)
+    u8 menuRowH; // 43
+    u16 listPos; // 44  Liste: erster sichtbarer Eintrag
+    u16 listCount; // 46  Liste: Anzahl Einträge
+    s16 itemY0; // 48  y der ersten Zeile
+    s16 itemX0; // 50
+    u16 colW; // 52
+    u8 dispSelect; // 54  1 = Haupt-Engine oben
+    u8 screen3D; // 55  gSystem.whichScreenIs3D
+    u32 systemAddr; // 56  &gSystem
+    u32 menusSeen; // 60  Zähler (Diagnose)
+    u32 tapsHit; // 64
+    u32 tapsAsA; // 68
+    u32 noTapAUntil; // 72  bis zu diesem Bild löst Tippen kein A aus (z. B. Namenseingabe)
+    u32 textFrame; // 76  Bild, in dem zuletzt Text gedruckt wurde oder auf Weiter gewartet hat
+    u32 textWaitFrame; // 80  Bild, in dem ein Text zuletzt auf A/Weiter gewartet hat
+    u32 battleFrame; // 84  Bild, in dem zuletzt ein Kampf lief
+    u32 bottomFreeFrame; // 88  Bild, in dem der untere Bildschirm frei war (Oberwelt, Intro): dann auch Listen unten
+    u32 reserved1; // 92
+    // ---- Oberwelt (nur wenn der Spieler frei laufen kann) ----
+    u32 fieldFrame; // 96  Bild, in dem die Oberwelt zuletzt Eingaben angenommen hat
+    s16 playerX; // 100  Kachel
+    s16 playerZ; // 102
+    u8 playerDir; // 104  0 = oben, 1 = unten, 2 = links, 3 = rechts
+    u8 npcCount; // 105
+    u8 fieldPad[2]; // 106
+    TouchBridgeNpc npcs[TB_MAX_NPCS]; // 108 .. 268
+    // ---- Menü, das die App unten anzeigt (nur mit TB_APP_MENUS_BOTTOM) ----
+    u32 ownFrame; // 268  Bild, in dem das Menü oben ausgeblendet und hier beschrieben wurde
+    u32 pixAddr; // 272  Pixel des Menüfensters (Kacheln, 4 bpp, 32 Byte je Kachel)
+    u8 tilesW; // 276  Fenstergröße in Kacheln
+    u8 tilesH; // 277
+    u8 colorMode; // 278  0 = 16 Farben
+    u8 menuStyle; // 279  0 = normal, 1 = Ja/Nein
+    u8 labelX; // 280  ab hier beginnt der Text einer Zeile (Pixel im Fenster, links davon der Cursor)
+    u8 bgIndex; // 281  Hintergrundfarbe des Fensters (Farbnummer)
+    u8 ownPad[2]; // 282
+    u16 pal[16]; // 284  Farben des Fensters (BGR555)
+} TouchBridge; // 316
+
+extern TouchBridge gTouchBridge;
+
+void TouchBridge_Init(void);
+// einmal pro Bild direkt nach dem Lesen der Tasten aufrufen
+void TouchBridge_Frame(void);
+
+// Liegt ein Antippen für diesen Bildschirm vor? Dann wird es hier entnommen.
+BOOL TouchBridge_TakeTap(int screen, int *outX, int *outY);
+void TouchBridge_TapResult(u8 result);
+// Bildschirm (0 oben / 1 unten), auf dem eine BG-Ebene gerade zu sehen ist
+int TouchBridge_LayerScreen(u8 bgLayer);
+// Für Bildschirme, auf denen Tippen oben nichts bedeuten soll (jedes Bild aufrufen)
+void TouchBridge_SuppressTapA(void);
+// Text wird gedruckt (waiting = FALSE) oder wartet auf Weiter (TRUE)
+void TouchBridge_NoteText(BOOL waiting);
+// Kampf läuft (jedes Bild aus Battle_Main)
+void TouchBridge_NoteBattle(void);
+// Oberwelt: einmal pro Bild, wenn der Spieler frei laufen kann (aus field_system.c)
+void TouchBridge_FieldFrame(FieldSystem *fieldSystem);
+// Auswahlmenü oben: zeigt die App es unten an, wird es hier oben ausgeblendet (jedes Bild nach der
+// Eingabe aufrufen). Rückgabe TRUE = die App zeigt das Menü.
+// Kleine Auswahlmenüs (Menu) übernimmt die App überall, Listen (ListMenu) nur, wenn der untere
+// Bildschirm gerade nichts Eigenes zu bedienen hat (Oberwelt, Intro), sonst z. B. nicht im Beutel.
+BOOL TouchBridge_OwnMenuWindow(Window *window, int labelX, int bgIndex, int style, BOOL isList);
+// Der untere Bildschirm hat gerade nichts Eigenes zu bedienen (jedes Bild aufrufen)
+void TouchBridge_NoteBottomFree(void);
+// Hat die App im aktuellen Bild ein Menü übernommen?
+BOOL TouchBridge_MenuOwned(void);
+void TouchBridge_NoteMenu(u8 kind, u8 screen, int x, int y, int w, int h, int rows, int cols, int cursor, int rowH, int itemX0, int itemY0, int colW, int listPos, int listCount);
+
+#endif // POKEPLATINUM_TOUCH_BRIDGE_H
