+// Platin Touch: Antippen eines Eintrags (über die TouchBridge) wählt ihn direkt aus.
+// Rückgabe: Eintrag (>= 0) oder -1 (kein Treffer / kein Antippen).
+static int TryTouchSelect(Menu *menu)
+{
+    Window *window = menu->template.window;
+
+    if (window == NULL || menu->template.xSize == 0 || menu->template.ySize == 0) {
+        return -1;
+    }
+
+    int screen = TouchBridge_LayerScreen(window->bgLayer);
+    int originX = window->tilemapLeft * 8 - Bg_GetXOffset(window->bgConfig, window->bgLayer);
+    int originY = window->tilemapTop * 8 - Bg_GetYOffset(window->bgConfig, window->bgLayer);
+    int rowH = menu->lineHeight + menu->template.lineSpacing;
+    int colW = menu->width + menu->letterWidth * 2;
+    int width = window->width * 8;
+    int height = window->height * 8;
+
+    if (rowH <= 0) {
+        rowH = 16;
+    }
+
+    TouchBridge_NoteMenu(TB_MENU_MENU, screen, originX, originY, width, height, menu->template.ySize, menu->template.xSize, menu->cursorPos, rowH, originX, originY + menu->yOffset, colW, 0, menu->template.xSize * menu->template.ySize);
+
+    int tapX, tapY;
+    if (!TouchBridge_TakeTap(screen, &tapX, &tapY)) {
+        return -1;
+    }
+
+    // etwas Spielraum um das Fenster (Rahmen)
+    if (tapX < originX - 6 || tapX >= originX + width + 6 || tapY < originY - 6 || tapY >= originY + height + 6) {
+        TouchBridge_TapResult(TB_TAP_MISS);
+        return -1;
+    }
+
+    int row = (tapY - (originY + menu->yOffset)) / rowH;
+    if (tapY < originY + menu->yOffset) {
+        row = 0;
+    }
+    if (row >= menu->template.ySize) {
+        row = menu->template.ySize - 1;
+    }
+
+    int col = 0;
+    if (menu->template.xSize > 1 && colW > 0) {
+        col = (tapX - originX) / colW;
+        if (tapX < originX) {
+            col = 0;
+        }
+        if (col >= menu->template.xSize) {
+            col = menu->template.xSize - 1;
+        }
+    }
+
+    int pos = col * menu->template.ySize + row;
+
+    if (menu->template.choices[pos].index == MENU_HEADER) {
+        TouchBridge_TapResult(TB_TAP_MISS);
+        return -1;
+    }
+
+    if (pos != menu->cursorPos) {
+        u8 x, y;
+        u8 bgColor = Font_GetAttribute(menu->template.fontID, FONTATTR_BG_COLOR);
+
+        CalcCursorDrawCoords(menu, &x, &y, menu->cursorPos);
+        Window_FillRectWithColor(menu->template.window, bgColor, x, y, 8, menu->lineHeight);
+        menu->cursorPos = pos;
+        DrawCursor(menu);
+        Window_ScheduleCopyToVRAM(menu->template.window);
+    }
+
+    TouchBridge_TapResult(TB_TAP_HIT);
+    return pos;
+}
